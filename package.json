{
  "name": "marcosgualberto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "marcosgualberto.com — 10 estudos de homepage em TypeScript puro, sem framework",
  "scripts": {
    "brand": "node scripts/brand.mjs",
    "images": "node scripts/images.mjs",
    "build": "tsc && node .tsc/build.js",
    "dev": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "npm run build && node scripts/serve.mjs --open",
    "check": "tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "thumbs": "python scripts/thumbs.py",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.6.0"
  }
}
